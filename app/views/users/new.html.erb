<style>
  #error_explanation {
      background-color: red;
  }
</style>

<% if @user.errors.any? %>
  <div id="error_explanation">
    <h3><%= pluralize(@user.errors.count, "error") %> prohibited this post from being saved:</h3>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user do |form| %>
  Email: <%= form.email_field :email, value: "example@gmail.com" %><br>
  Password: <%= form.password_field :password %><br>
  Username: <%= form.text_field :username %><br><br>
  <%= form.submit %>
<% end %>

<%= link_to "Home", users_url %>